{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "android": {
        "buildType": "apk"
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "android": {
        "gradleCommand": ":app:assembleDebug -PreactNativeArchitectures=arm64-v8a"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": { "simulator": true }
    },
    "preview-device": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      },
      "ios": { "simulator": true }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    },
    "production-apk": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
