{"nusach":"chabad","id":"birchot_hareiya","sections":[{"title":{"he":"ברק ורעם","en":"Lightning and Thunder"},"segments":[{"he":[[{"t":"על הברקים מברך:","s":"n"}]]},{"he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, עוֹשֵׂה מַעֲשֵׂה בְרֵאשִׁית:"}]]},{"he":[[{"t":"על הרעמים מברך:","s":"n"}]]},{"he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, שֶׁכֹּחוֹ וּגְבוּרָתוֹ מָלֵא עוֹלָם:"}]]}]},{"title":{"he":"הקשת","en":"A Rainbow"},"segments":[{"he":[[{"t":"הרואה קשת:","s":"n"}]]},{"he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, זוֹכֵר הַבְּרִית וְנֶאֱמָן בִּבְרִיתוֹ וְקַיָּם בְּמַאֲמָרוֹ:"}]]}]},{"title":{"he":"ברכת האילנות","en":"Trees in Blossom"},"segments":[{"he":[[{"t":"היוצא בימי ניסן וראה אילנות שמוציאין פרח צריך לברך:","s":"n"}]]},{"he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, שֶׁלֹּא חִסַּר בְּעוֹלָמוֹ כְּלוּם וּבָרָא בוֹ בְּרִיוֹת טוֹבוֹת וְאִילָנוֹת טוֹבוֹת לֵיהָנוֹת בָּהֶם בְּנֵי אָדָם:"}]]}]},{"title":{"he":"ברכות שבח והודאה","en":"Further Blessings of Praise"},"segments":[{"he":[[{"t":"על שמועות שהם טובות לו ולאחרים מברך:","s":"n"}]]},{"he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, הַטוֹב וְהַמֵּטִיב:"}]]},{"he":[[{"t":"על שמועות רעות מברך:","s":"n"}]]},{"he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, דַּיַּן הָאֱמֶת:"}]]}]}],"credits":[{"title":"Weekday Siddur Chabad — Wikisource","license":"CC-BY-SA","url":"https://www.sefaria.org/Weekday_Siddur_Chabad"}]}